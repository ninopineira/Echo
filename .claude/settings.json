{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm install)",
      "Bash(npm ci)",
      "Bash(npm test)",
      "Bash(npm test *)",
      "Bash(npm run *)",
      "Bash(npx vitest *)",
      "Bash(npx tsc *)",
      "Bash(npx eslint *)",
      "Bash(npx prettier *)",
      "Bash(npx tsx scripts/*)",
      "Bash(npm view *)",
      "Bash(npm ls *)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "PowerShell(npm install)",
      "PowerShell(npm ci)",
      "PowerShell(npm test)",
      "PowerShell(npm test *)",
      "PowerShell(npm run *)",
      "PowerShell(npx vitest *)",
      "PowerShell(npx tsc *)",
      "PowerShell(npx eslint *)",
      "PowerShell(npx prettier *)",
      "PowerShell(npx tsx scripts/*)",
      "PowerShell(npm view *)",
      "PowerShell(npm ls *)",
      "PowerShell(git status)",
      "PowerShell(git status *)",
      "PowerShell(git diff)",
      "PowerShell(git diff *)",
      "PowerShell(git log *)",
      "PowerShell(git show *)",
      "PowerShell(git add *)",
      "PowerShell(git commit *)",
      "Edit(src/**)",
      "Edit(scripts/**)",
      "Edit(docs/**)",
      "Edit(CLAUDE.md)",
      "Edit(README.md)"
    ],
    "ask": [
      "Bash(git push *)",
      "PowerShell(git push *)",
      "Bash(npm install *)",
      "PowerShell(npm install *)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "PowerShell(Remove-Item -Recurse *)",
      "Bash(npm publish *)",
      "PowerShell(npm publish *)",
      "Bash(git push --force *)",
      "PowerShell(git push --force *)"
    ]
  }
}
